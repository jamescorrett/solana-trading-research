# Required. Create a Helius API key in your Helius dashboard.
HELIUS_API_KEY=replace_me

# Public wallet attribution used for research only; keep configurable.
TARGET_WALLET=CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o

# Official Pump program on Solana mainnet/devnet.
PUMP_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Standard Solana WebSocket endpoint. This collector uses logsSubscribe,
# which is available on Helius Free.
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key={api_key}
COMMITMENT=processed
DATA_DIR=./data
FLUSH_EVERY=25
RECONNECT_MAX_SECONDS=30
INCLUDE_FAILED=false
